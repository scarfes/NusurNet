// =============================================================================
// NusurNet — Prisma schema
// =============================================================================
// Sprint 0: minimal schema with one model to validate the DB connection.
// Sprint 1 will introduce the full data model (User, University, Service, etc.)
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm, unaccent, citext, uuidOssp(map: "uuid-ossp")]
}

// Locale enum used across translatable models (kept here for early validation)
enum Locale {
  IT
  FR
  AR
  EN
}

// Minimal "ping" model used to verify migrations and connection in Sprint 0.
// Will be removed/replaced in Sprint 1.
model HealthCheck {
  id        String   @id @default(uuid()) @db.Uuid
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("health_check")
}
